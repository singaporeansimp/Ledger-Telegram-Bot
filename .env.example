# Copy to .env (chmod 600) and fill in. .env is git-ignored; never commit real values.
BOT_TOKEN=123456:replace-with-the-token-from-BotFather
# Optional: path to the ESG Flip bot's SQLite file, so its results can be added to the ledger (see README)
ESG_DB_PATH=/path/to/esgbot.sqlite3
# Optional: the one Telegram user id (a number, not a username) allowed to use /purge. Without it /purge is off.
OWNER_USER_ID=123456789
